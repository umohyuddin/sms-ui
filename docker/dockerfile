FROM node:18-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci || npm install
COPY . .
# Build with base-href so the app expects to be served under /tenant-portal/
# Disable font inlining by setting NG_BUILD_SKIP_FETCH_GOOGLE_FONTS inline
# This prevents the build from trying to fetch fonts from the internet (which fails in isolated Docker)
RUN NG_BUILD_SKIP_FETCH_GOOGLE_FONTS=true npm run build -- --output-path=dist/multi-tenant-manager --base-href=/tenant-portal/ --configuration=production

# Stage 2: Serve with NGINX
FROM nginx:alpine

COPY --from=build /app/dist/multi-tenant-manager/browser /usr/share/nginx/html/tenant-portal

# Copy nginx configuration from repo (path relative to build context)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Ensure the config directory exists inside the tenant-portal folder
RUN mkdir -p /usr/share/nginx/html/tenant-portal/assets/config

# Optional: copy a default config (for local/dev)
COPY ./src/assets/config/config.json /usr/share/nginx/html/tenant-portal/assets/config/config.json

EXPOSE 80


CMD ["nginx", "-g", "daemon off;"]